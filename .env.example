# ===================================================
# SYNTRA — ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env.local and populate with your credentials
# ===================================================

# 1. SUPABASE CONFIGURATION
# Found in your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# 2. GITHUB OAUTH (For 1-Click "Continue with GitHub" Login)
# Create in GitHub -> Settings -> Developer Settings -> OAuth Apps
# Authorization callback URL: https://syntra.rudreshp.me/api/auth/github-callback (or http://localhost:3000/api/auth/github-callback for dev)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# 3. SESSION ENCRYPTION & APP URL
# Generate a strong 32+ character random string
JWT_SECRET=your_super_secret_jwt_encryption_key
NEXT_PUBLIC_APP_URL=https://syntra.rudreshp.me
NEXT_PUBLIC_LEETCODE_URL=https://leetcode.com

# 4. BACKEND REPOSITORY & API ENDPOINTS
DEFAULT_GITHUB_REPO=leetcode-dsa-solutions
GITHUB_API_URL=https://api.github.com
GITHUB_OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_USER_API_URL=https://api.github.com/user
LEETCODE_GRAPHQL_URL=https://leetcode.com/graphql
